FROM osrf/ros:jazzy-desktop-full

# --- Environment Configuration ---
ENV DEBIAN_FRONTEND=noninteractive

# Localisation & Timezone
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    TZ=Asia/Ho_Chi_Minh

# ROS 2 & DDS Setup
ENV ROS_DOMAIN_ID=0 \
    ROS_LOCALHOST_ONLY=0 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Shell Setup
ENV SHELL=/usr/bin/zsh \
    ZSH=/root/.oh-my-zsh

# Graphics & Mesa (WSL2 NVIDIA D3D12)
ENV GALLIUM_DRIVER=d3d12 \
    MESA_D3D12_DEFAULT_ADAPTER_NAME=NVIDIA \
    LD_LIBRARY_PATH=/usr/lib/wsl/lib:${LD_LIBRARY_PATH}

# --- Install APT Packages (Grouped & Alphabetized) ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 1. System Utilities & Shell
    ca-certificates \
    curl \
    git \
    locales \
    tzdata \
    tree \
    zsh \
    # 2. Build Tools & Compilers
    build-essential \
    clang \
    clang-format \
    clang-tidy \
    cmake \
    cppcheck \
    gdb \
    ninja-build \
    pkg-config \
    # 3. Python Development Tools
    python3-argcomplete \
    python3-autopep8 \
    python3-colcon-common-extensions \
    python3-dev \
    python3-flake8 \
    python3-pip \
    python3-pytest \
    python3-rosdep \
    python3-setuptools \
    python3-vcstool \
    python3-venv \
    python3-wheel \
    # 4. Networking & DDS
    iproute2 \
    iputils-ping \
    ros-jazzy-rmw-cyclonedds-cpp \
    tcpdump \
    # 5. Graphics & OpenGL (Mesa)
    libegl-mesa0 \
    libgl1-mesa-dri \
    libglvnd0 \
    libglx-mesa0 \
    mesa-utils \
    # 6. ROS2 Package
    ## Xử lý ảnh
    ros-jazzy-camera-info-manager \
    ros-jazzy-cv-bridge \
    ros-jazzy-image-pipeline \
    ros-jazzy-image-transport \
    ros-jazzy-image-transport-plugins \
    ros-jazzy-vision-opencv \
    ## Driver camera cho Raspberry Pi
    ros-jazzy-v4l2-camera \
    ## IMU & Sensor Fusion
    ros-jazzy-imu-filter-madgwick \
    ros-jazzy-robot-localization \
    ## SLAM
    ros-jazzy-nav2-map-server \
    ros-jazzy-slam-toolbox \
    ## Mô phỏng Gazebo & Điều khiển
    ros-jazzy-gz-ros2-control \
    ros-jazzy-ros-gz \
    ros-jazzy-ros-gz-bridge \
    ros-jazzy-ros-gz-sim \
    ros-jazzy-ros2-control \
    ros-jazzy-ros2-controllers \
    ## Robot model & TF
    ros-jazzy-joint-state-publisher \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-tf-transformations \
    ros-jazzy-tf2-tools \
    ros-jazzy-xacro \
    ## Logs
    ros-jazzy-rosbag2-storage-mcap \
    ## Giám sát hệ thống
    ros-jazzy-diagnostic-aggregator \
    ros-jazzy-diagnostic-updater \
    ## Test
    ros-jazzy-teleop-twist-keyboard \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# --- Python Dependencies ---
COPY docker/requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir --break-system-packages -r /tmp/requirements.txt \
    --timeout 120 \
    --retries 5 \
    --ignore-installed

# Ghim setuptools < 80 để giữ tương thích với colcon --symlink-install
RUN python3 -m pip install --no-cache-dir --break-system-packages --ignore-installed \
    "setuptools<80"

# --- Zsh & Oh My Zsh Setup ---
RUN git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git "$ZSH" \
    && git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$ZSH/custom/themes/powerlevel10k" \
    && git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions.git "$ZSH/custom/plugins/zsh-autosuggestions" \
    && git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting.git "$ZSH/custom/plugins/zsh-syntax-highlighting"

# Copy Shell Configurations
COPY docker/zshrc /root/.zshrc
COPY docker/p10k.zsh /root/.p10k.zsh
COPY docker/ros2-functions.zsh /root/.ros2-functions.zsh

# Auto-source ROS 2 & Workspace cho Bash Shell
RUN printf '%s\n' \
    'source /opt/ros/jazzy/setup.bash' \
    'if [ -f /ros2-ws/install/setup.bash ]; then source /ros2-ws/install/setup.bash; fi' \
    >> /root/.bashrc

# --- Workspace & Entrypoint ---
WORKDIR /ros2-ws

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["zsh"]