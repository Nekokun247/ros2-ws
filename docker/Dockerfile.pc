FROM osrf/ros:jazzy-desktop-full

# Tắt hộp thoại tương tác trong quá trình cài đặt package.
ENV DEBIAN_FRONTEND=noninteractive

# Cấu hình locale và shell mặc định.
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    SHELL=/usr/bin/zsh \
    ZSH=/root/.oh-my-zsh

# Cấu hình ROS 2 dùng chung giữa máy phát triển và Raspberry Pi 5.
ENV ROS_DOMAIN_ID=0 \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Tăng tốc đồ họa bằng Mesa D3D12 khi chạy Docker trong WSL2.
ENV GALLIUM_DRIVER=d3d12 \
    MESA_D3D12_DEFAULT_ADAPTER_NAME=NVIDIA \
    LD_LIBRARY_PATH=/usr/lib/wsl/lib

# Cài công cụ phát triển C/C++, Python, ROS 2, đồ họa Mesa và Zsh.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang \
    clang-format \
    clang-tidy \
    cmake \
    cppcheck \
    curl \
    gdb \
    git \
    libegl-mesa0 \
    libgl1-mesa-dri \
    libglvnd0 \
    libglx-mesa0 \
    locales \
    mesa-utils \
    ninja-build \
    pkg-config \
    python3-autopep8 \
    python3-colcon-common-extensions \
    python3-dev \
    python3-flake8 \
    python3-pip \
    python3-pytest \
    python3-rosdep \
    python3-setuptools \
    python3-venv \
    python3-wheel \
    ros-jazzy-rmw-cyclonedds-cpp \
    tree \
    zsh \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# Cài Oh My Zsh, Powerlevel10k và các plugin được khai báo trong zshrc.
RUN git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git "$ZSH" \
    && git clone --depth=1 https://github.com/romkatv/powerlevel10k.git \
    "$ZSH/custom/themes/powerlevel10k" \
    && git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions.git \
    "$ZSH/custom/plugins/zsh-autosuggestions" \
    && git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting.git \
    "$ZSH/custom/plugins/zsh-syntax-highlighting"

# Sao chép cấu hình shell và Powerlevel10k từ thư mục docker của dự án.
COPY docker/zshrc /root/.zshrc
COPY docker/p10k.zsh /root/.p10k.zsh
COPY docker/ros2-functions.zsh /root/.ros2-functions.zsh

# Giữ Bash hoạt động và tự động nạp môi trường ROS 2 khi cần sử dụng.
RUN printf '%s\n' \
    'source /opt/ros/jazzy/setup.bash' \
    'if [ -f /ros2-ws/install/setup.bash ]; then source /ros2-ws/install/setup.bash; fi' \
    >> /root/.bashrc

WORKDIR /ros2-ws

# Khởi tạo môi trường ROS 2 trước khi chạy lệnh của container.
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["zsh"]
