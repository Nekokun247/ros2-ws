FROM ros:jazzy-ros-base-noble

# Không hiển thị hộp thoại tương tác khi cài đặt package.
ENV DEBIAN_FRONTEND=noninteractive

# Thiết lập locale UTF-8 cho terminal, ROS 2 và công cụ build.
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# Cấu hình ROS 2/DDS mặc định, đồng nhất với máy phát triển.
# CYCLONEDDS_URI được khai báo trong Compose vì file XML được bind mount lúc chạy.
ENV ROS_DOMAIN_ID=0 \
    ROS_LOCALHOST_ONLY=0 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Cài công cụ build, kiểm thử, chẩn đoán mạng/DDS và giao tiếp phần cứng.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    gdb \
    git \
    gpiod \
    i2c-tools \
    iproute2 \
    iputils-ping \
    libgpiod-dev \
    locales \
    ninja-build \
    pkg-config \
    python3-colcon-common-extensions \
    python3-dev \
    python3-pip \
    python3-pytest \
    python3-rosdep \
    python3-setuptools \
    python3-venv \
    python3-wheel \
    ros-jazzy-rmw-cyclonedds-cpp \
    tcpdump \
    usbutils \
    v4l-utils \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# Tự động nạp ROS 2 Jazzy và workspace khi mở Bash tương tác.
RUN printf '%s\n' \
    'source /opt/ros/jazzy/setup.bash' \
    'if [ -f /ros2-ws/install/setup.bash ]; then source /ros2-ws/install/setup.bash; fi' \
    >> /root/.bashrc

# Workspace được bind mount từ host thông qua Docker Compose.
WORKDIR /ros2-ws

# Entrypoint nạp môi trường ROS 2 trước khi thực thi lệnh của container.
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
