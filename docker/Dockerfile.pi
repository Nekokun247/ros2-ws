FROM ros:jazzy-ros-base-noble

# Tránh hộp thoại tương tác trong quá trình cài package.
ENV DEBIAN_FRONTEND=noninteractive

# Cấu hình ROS 2 dùng chung với laptop.
ENV ROS_DOMAIN_ID=0
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Công cụ phát triển và tiện ích phần cứng cho Raspberry Pi 5.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    gdb \
    git \
    python3-pip \
    python3-venv \
    python3-dev \
    python3-setuptools \
    python3-wheel \
    python3-pytest \
    python3-colcon-common-extensions \
    python3-rosdep \
    ros-jazzy-rmw-cyclonedds-cpp \
    usbutils \
    i2c-tools \
    v4l-utils \
    gpiod \
    libgpiod-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ros2-ws

# Cài entrypoint và tự động nạp môi trường ROS 2 trong shell tương tác.
COPY docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh && \
    echo 'source /opt/ros/jazzy/setup.bash' >> /root/.bashrc && \
    echo 'if [ -f /ros2-ws/install/setup.bash ]; then source /ros2-ws/install/setup.bash; fi' >> /root/.bashrc

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
