FROM ros:jazzy-ros-base-noble

# --- Environment Configuration ---
ENV DEBIAN_FRONTEND=noninteractive

# Localisation & Timezone
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    TZ=Asia/Ho_Chi_Minh

# ROS 2 & DDS Setup
ENV ROS_DOMAIN_ID=0 \
    ROS_LOCALHOST_ONLY=0 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# --- Install APT Packages (Grouped & Alphabetized) ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 1. System Utilities & Hardware Tools
    ca-certificates \
    curl \
    git \
    gpiod \
    i2c-tools \
    libgpiod-dev \
    locales \
    tzdata \
    tree \
    usbutils \
    v4l-utils \
    # 2. Build Tools & Compilers
    build-essential \
    cmake \
    gdb \
    ninja-build \
    pkg-config \
    # 3. Python Development Tools
    python3-argcomplete \
    python3-autopep8 \
    python3-colcon-common-extensions \
    python3-dev \
    python3-flake8 \
    python3-pip \
    python3-pytest \
    python3-rosdep \
    python3-setuptools \
    python3-vcstool \
    python3-venv \
    python3-wheel \
    # 4. Networking & DDS
    iproute2 \
    iputils-ping \
    ros-jazzy-rmw-cyclonedds-cpp \
    tcpdump \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# --- Python Dependencies ---
COPY docker/requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir --break-system-packages -r /tmp/requirements.txt \
    --timeout 120 \
    --retries 5 \
    --ignore-installed

# Ghim setuptools < 80 để giữ tương thích với colcon --symlink-install
RUN python3 -m pip install --no-cache-dir --break-system-packages --ignore-installed \
    "setuptools<80"

# Auto-source ROS 2 & Workspace cho Bash Shell
RUN printf '%s\n' \
    'source /opt/ros/jazzy/setup.bash' \
    'if [ -f /ros2-ws/install/setup.bash ]; then source /ros2-ws/install/setup.bash; fi' \
    >> /root/.bashrc

# --- Workspace & Entrypoint ---
WORKDIR /ros2-ws

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]